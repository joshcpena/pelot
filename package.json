{
  "name": "pelot",
  "version": "0.0.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:local": "set -a; [ -f .env ] && . ./.env; set +a; ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk} npx eas build --platform android --profile preview --local",
    "install:android:local": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk}; npm run build:android:local -- --output ./pelot-preview.apk && \"$ANDROID_HOME/platform-tools/adb\" install -r ./pelot-preview.apk",
    "install:android:fast": "set -a; [ -f .env ] && . ./.env; set +a; export NODE_ENV=production; export ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk}; export ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}; cd android && ./gradlew :app:installRelease --build-cache --parallel --configure-on-demand -x lint -x test",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/ui": "~56.0.14",
    "@maplibre/maplibre-react-native": "^11.2.1",
    "expo": "~56.0.4",
    "expo-battery": "^56.0.4",
    "expo-brightness": "~56.0.5",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.15",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.11",
    "expo-location": "~56.0.13",
    "expo-router": "~56.2.6",
    "expo-sensors": "~56.0.5",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~56.0.4",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "private": true
}
